# JARVIS Core Environment Configuration

# Server Settings
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5173

# LLM Provider Configuration
# Supported providers: 'gemini', 'openai', 'ollama', 'anthropic', 'mock'
LLM_PROVIDER=gemini

# API Key (Required for 'gemini', 'openai', 'anthropic'; NOT required for 'ollama' or 'mock')
LLM_API_KEY=your_api_key_here

# Model Name
# Examples:
#   Gemini: gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro
#   OpenAI: gpt-4o-mini, gpt-4o
#   Ollama: llama3.2, qwen2.5-coder
LLM_MODEL=gemini-2.0-flash

# Base URL (Optional - automatically resolved per LLM_PROVIDER if left empty)
# Defaults:
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai
#   OpenAI: https://api.openai.com/v1
#   Ollama: http://localhost:11434/v1
LLM_BASE_URL=

# Logging
LOG_LEVEL=info

# Web Search Provider (Optional)
WEB_SEARCH_API_KEY=
